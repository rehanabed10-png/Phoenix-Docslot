# Application Port
PORT=3000

# CORS Allowed Origins (Comma-separated, optional - defaults to localhost:5173, 127.0.0.1:5173, and local Vite ports)
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Connection (Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Project Base URL (used for JWKS token verification and issuer validation)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Supabase Service Role Key (Backend Only - NEVER expose to frontend or commit to version control)
# Optional: Used by the seed script to automatically provision demo accounts in Supabase Auth.
# If not provided, demo users can be created via Supabase Dashboard or frontend signup.
# SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Demo User Password (Backend Only)
# Required when using SUPABASE_SERVICE_ROLE_KEY to auto-create new demo accounts.
# A hardcoded or predictable default password is never used; set an explicit secure demo password.
# DEMO_USER_PASSWORD=YourConfiguredDemoPassword123!

# Manual Demo User UUID Overrides (Optional)
# If creating demo accounts manually via Supabase Dashboard or client signup, specify their auth.users UUIDs:
# DEMO_PATIENT_USER_ID=00000000-0000-4000-8000-000000000004
# DEMO_DOCTOR_1_USER_ID=10000000-0000-4000-8000-000000000001
# DEMO_DOCTOR_2_USER_ID=20000000-0000-4000-8000-000000000002
# DEMO_DOCTOR_3_USER_ID=30000000-0000-4000-8000-000000000003
